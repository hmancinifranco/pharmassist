# === AWS General ===
AWS_PROFILE=your-profile
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# === Bedrock ===
# Use inference profile ID (us. prefix) — NOT the raw model ID
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1

# === Tags (aplicados a todos los recursos via CDK Aspects) ===
TAG_PROJECT=PharmAssist
TAG_ENVIRONMENT=dev
TAG_OWNER=your-team

# === Frontend ===
VITE_API_URL=http://localhost:8000

# === API Gateway (from CDK PharmAssistStack outputs) ===
API_URL=https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com

# === AgentCore ===
AGENTCORE_AGENT_NAME=pharmassist-agent
AGENTCORE_REGION=us-east-1
# Set AGENTCORE_AGENT_ARN to proxy /api/chat through AgentCore instead of local agent.
# Leave empty or unset to use the local Strands agent (default for local dev).
AGENTCORE_AGENT_ARN=

# === DynamoDB Table Names (from CDK PharmAssistStack outputs) ===
MEDICOS_TABLE_NAME=PharmAssistStack-MedicosTableXXXXX-YYYYY
VISITAS_TABLE_NAME=PharmAssistStack-VisitasTableXXXXX-YYYYY
VENTAS_TABLE_NAME=PharmAssistStack-VentasTableXXXXX-YYYYY
PLANIFICADAS_TABLE_NAME=PharmAssistStack-PlanificadasTableXXXXX-YYYYY
MINUTAS_TABLE_NAME=PharmAssistStack-MinutasTableXXXXX-YYYYY

# === Cognito (from CDK PharmAssistStack outputs) ===
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=us-east-1
USER_POOL_ID=us-east-1_XXXXXXXXX

# === Demo users (scripts/create-demo-user.py y scripts/setup_demo_users.py) ===
# IMPORTANTE: usar passwords fuertes y distintas por usuario. Nunca commitear valores reales.
DEMO_USER_EMAIL=demo-apm-1@example.com
DEMO_USER_PASSWORD=change-me-strong-password
DEMO_USER_APM_ID="Demo APM 1"
DEMO_USER_2_EMAIL=demo-apm-2@example.com
DEMO_USER_2_PASSWORD=change-me-strong-password
DEMO_USER_2_APM_ID="Demo APM 2"

# === Peccy Demo User (scripts/setup_peccy_user.py) ===
PECCY_EMAIL=peccy@example.com
PECCY_PASSWORD=change-me-strong-password

# === WebSocket (from CDK PharmAssistStack outputs — fill after cdk deploy) ===
VITE_WS_URL=wss://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com/prod

# === Audio Pipeline (from CDK PharmAssistStack outputs — fill after cdk deploy) ===
AUDIO_BUCKET_NAME=PharmAssistStack-AudioUploadsBucketXXXXX-YYYYY

# === BidiAgent Voice (from CDK PharmAssistStack outputs — fill after cdk deploy) ===
# ARN del BidiAgent desplegado en AgentCore (container deployment, protocolo WebSocket)
BIDIAGENT_AGENT_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT:runtime/agent-XXXXX
# Cognito Identity Pool ID — credenciales AWS temporales para conexión SigV4 desde el browser
IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Variables Vite para el frontend (modo voz directo a AgentCore)
VITE_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_BIDIAGENT_AGENT_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT:runtime/agent-XXXXX

# === Datos (ruta relativa a la raíz del proyecto donde están los CSVs) ===
DATA_DIR=.

# === Data Sources Simulation (from CDK DataSourcesStack outputs) ===
DATASOURCES_RDS_ENDPOINT=xxx.xxx.us-east-1.rds.amazonaws.com
DATASOURCES_RDS_PORT=5432
DATASOURCES_DB_NAME=pharmassist_sources
DATASOURCES_DB_USER=postgres
DATASOURCES_DB_PASSWORD=from-secrets-manager
DATASOURCES_RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:xxx
DATASOURCES_VPC_ID=vpc-xxxxxxxxx
DATASOURCES_BASTION_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

# === Data Lake Foundation (from CDK DataLakeStack outputs) ===
DATALAKE_BUCKET_NAME=datalakestack-lakebucket9cd7bbd2-XXXXX
DATALAKE_CRM_DATABASE=pharmassist_crm
DATALAKE_CUP_DATABASE=pharmassist_cup
DATALAKE_IQVIA_DATABASE=pharmassist_iqvia
DATALAKE_MAESTROS_DATABASE=pharmassist_maestros
DATALAKE_ATHENA_WORKGROUP=pharmassist-validation

# === Ingestion Stack inputs (required for cdk deploy of IngestionStack) ===
RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:SimulationDbSecretXXX
DATASOURCES_VPC_ID=vpc-xxxxxxxxx
LAKE_BUCKET_NAME=datalakestack-lakebucket9cd7bbd2-XXXXX
GLUE_DB_CRM=pharmassist_crm
GLUE_DB_CUP=pharmassist_cup
GLUE_DB_IQVIA=pharmassist_iqvia
GLUE_DB_MAESTROS=pharmassist_maestros

# === Ingestion Stack outputs (from CDK IngestionStack deploy) ===
INGESTION_STATE_MACHINE_ARN=arn:aws:states:us-east-1:ACCOUNT:stateMachine:pharmassist-ingestion-pipeline
INGESTION_GLUE_JOB_NAME=pharmassist-parquet-to-iceberg
INGESTION_SCHEDULE_ARN=arn:aws:scheduler:us-east-1:ACCOUNT:schedule/default/pharmassist-ingestion-schedule

# === ProduccionPocStack outputs (from CDK deploy) ===
POC_AURORA_ENDPOINT=produccionpocstack-auroracluster-XXXXX.cluster-YYYYY.us-east-1.rds.amazonaws.com
POC_AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:AuroraSecretXXXXX-YYYYY
POC_VPC_ID=vpc-xxxxxxxxxxxxxxxxx
POC_SEED_LAMBDA_ARN=arn:aws:lambda:us-east-1:ACCOUNT:function:ProduccionPocStack-SeedDataFunctionXXXXX-YYYYY

# === POC CodeAgent (AgentCore deploy) ===
POC_CODEAGENT_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT:runtime/pharmassist_poc_codeagent-XXXXX
POC_CODEAGENT_NAME=pharmassist_poc_codeagent
